<mxfile host="app.diagrams.net">
  <diagram name="LearnHub Schema &amp; Permissions" id="0">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Legend -->
        <mxCell id="LegendBox" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font color=&quot;#1ba1e2&quot;&gt;-- Dashed Blue&lt;/font&gt;: Role Permissions / Actions&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;— Solid Black&lt;/font&gt;: Database Foreign Key Relations" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- =================== ROLES =================== -->
        <mxCell id="Role_Admin" value="&lt;b&gt;ROLE: Admin&lt;/b&gt;&lt;br&gt;Highest Privilege" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Role_CM" value="&lt;b&gt;ROLE: Content Manager&lt;/b&gt;&lt;br&gt;Platform Content" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="50" y="300" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Role_Instructor" value="&lt;b&gt;ROLE: Instructor&lt;/b&gt;&lt;br&gt;Course Creator" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="50" y="500" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Role_Student" value="&lt;b&gt;ROLE: Student&lt;/b&gt;&lt;br&gt;Learner" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="50" y="750" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- =================== ENTITIES =================== -->
